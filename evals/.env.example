# Copy this file to .env (same folder) and fill in your values.
# Find them in the Conversational Agents console: agent dropdown → Agent settings, or in the agent's URL
# .../projects/<CX_PROJECT_ID>/locations/<CX_LOCATION>/agents/<CX_AGENT_ID>/...
CX_PROJECT_ID=your-project-id
CX_LOCATION=global
CX_AGENT_ID=your-agent-id
# Stage 2: the AI copy of the agent, where the AI writes fee answers ("Conversational support agent - AI")
CX_AI_AGENT_ID=your-ai-agent-id
